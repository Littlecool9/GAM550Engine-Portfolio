{
    "version": 6,
    "configurePresets": [
        {
            "name": "base",
            "hidden": true,
            "binaryDir": "${sourceDir}/builds/${presetName}",
            "toolchainFile": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake",
            "cacheVariables": {
                "CMAKE_EXPORT_COMPILE_COMMANDS": true
            }
        },
        {
            "name": "windows-cache",
            "hidden": true,
            "environment": {
                "VCPKG_DOWNLOADS": "$env{LOCALAPPDATA}/vcpkg/downloads",
                "VCPKG_DEFAULT_BINARY_CACHE": "$env{LOCALAPPDATA}/vcpkg/archives"
            }
        },
        {
            "name": "windows-msvc-debug",
            "displayName": "Debug",
            "inherits": [
                "base",
                "windows-cache"
            ],
            "generator": "Ninja",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug"
            },
            "condition": {
                "type": "equals",
                "lhs": "${hostSystemName}",
                "rhs": "Windows"
            }
        },
        {
            "name": "windows-msvc-release",
            "displayName": "Release",
            "inherits": [
                "base",
                "windows-cache"
            ],
            "generator": "Ninja",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release"
            },
            "condition": {
                "type": "equals",
                "lhs": "${hostSystemName}",
                "rhs": "Windows"
            }
        },
        {
            "name": "windows-msvc-game-debug",
            "displayName": "Game Debug (no editor)",
            "inherits": "windows-msvc-debug",
            "cacheVariables": {
                "MJOLNIR_WITH_EDITOR": "OFF"
            }
        },
        {
            "name": "windows-msvc-game-release",
            "displayName": "Game Release (no editor)",
            "inherits": "windows-msvc-release",
            "cacheVariables": {
                "MJOLNIR_WITH_EDITOR": "OFF"
            }
        }
    ],
    "buildPresets": [
        {
            "name": "windows-msvc-debug",
            "displayName": "Debug",
            "configurePreset": "windows-msvc-debug"
        },
        {
            "name": "windows-msvc-release",
            "displayName": "Release",
            "configurePreset": "windows-msvc-release"
        },
        {
            "name": "windows-msvc-game-debug",
            "displayName": "Game Debug (no editor)",
            "configurePreset": "windows-msvc-game-debug"
        },
        {
            "name": "windows-msvc-game-release",
            "displayName": "Game Release (no editor)",
            "configurePreset": "windows-msvc-game-release"
        }
    ]
}
