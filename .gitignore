# build files
/[Bb]uild
/[Bb]uilds
/cmake-build-*

/logs

# Published terrain releases: TerrainTool sync writes them on every build
/games/*/terrain/releases/

# Machine-local terrain streaming budgets, written per install next to the executable
terrain_streaming.local.json

# Local code retrieval caches
/.rag/
__pycache__/

# IDE
/.idea
/.vscode

# Per-issue terrain handoffs and evidence stay local.
/docs/terrain-p2-[0-9]*
