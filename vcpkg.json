{
    "name": "mjolnir",
    "version": "0.1.0",
    "builtin-baseline": "05925b52317eb9a900a8583782e630aafd7a8929",
    "dependencies": [
        "fastgltf",
        "stb",
        "spdlog",
        "glfw3",
        "glm",
        "vulkan",
        "volk",
        "vulkan-memory-allocator",
        "catch2",
        "nlohmann-json",
        "joltphysics",
        "luajit",
        {
            "name": "pkgconf",
            "host": true
        },
        "sol2",
        "catch2"
    ],
    "features": {
        "large-world": {
            "description": "Double-precision Jolt to match double world positions; the root CMakeLists.txt selects it from MIR_LARGE_WORLD",
            "dependencies": [
                {
                    "name": "joltphysics",
                    "features": [
                        "double-precision"
                    ]
                }
            ]
        }
    },
    "$comment": "builtin-baseline = SHA of vcpkg"
}
