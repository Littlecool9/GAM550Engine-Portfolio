file(READ "${PLAN}" plan)
string(JSON first GET "${plan}" routes 0)
string(JSON first SET "${first}" frames 32)
string(JSON plan SET "${plan}" routes "[${first}]")
string(JSON plan SET "${plan}" validation true)
string(JSON plan SET "${plan}" pace false)
string(JSON plan SET "${plan}" output "\"${OUTPUT}\"")
file(WRITE "${OUTPUT}.plan.json" "${plan}")
execute_process(COMMAND "${ENGINE}" --terrain-benchmark "${OUTPUT}.plan.json"
    WORKING_DIRECTORY "${RUN_DIR}" RESULT_VARIABLE result TIMEOUT 110)
if(NOT result EQUAL 0)
    message(FATAL_ERROR "Terrain benchmark exited with ${result}")
endif()
file(READ "${OUTPUT}" trace)
string(JSON complete GET "${trace}" completed)
string(JSON count LENGTH "${trace}" frames)
string(JSON gpu_count LENGTH "${trace}" gpuFrames)
if(NOT complete OR NOT count EQUAL 32 OR gpu_count LESS 1)
    message(FATAL_ERROR "Benchmark did not retain all frames and GPU timings")
endif()
foreach(index RANGE 0 31)
    string(JSON reads GET "${trace}" frames ${index} mainThreadRangeReads)
    if(NOT reads EQUAL 0)
        message(FATAL_ERROR "Terrain benchmark found a main-thread payload read")
    endif()
    string(JSON views LENGTH "${trace}" frames ${index} views)
    if(views GREATER 0)
        math(EXPR last "${views} - 1")
        foreach(view RANGE 0 ${last})
            string(JSON duplicated GET "${trace}" frames ${index} views ${view} duplicatedTiles)
            if(NOT duplicated EQUAL 0)
                message(FATAL_ERROR "Terrain benchmark found duplicate coverage")
            endif()
        endforeach()
    endif()
endforeach()
